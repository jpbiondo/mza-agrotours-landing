---
import { cultivos, meses } from "../../data/landing";
import SectionHeader from "../ui/SectionHeader.astro";
import T from "../ui/T.astro";

// Clases literales de columna: Tailwind solo genera las que ve escritas
// completas. La columna 1 es el nombre del cultivo; el mes m va en la m + 1.
const colStart = ["", "", "col-start-2", "col-start-3", "col-start-4", "col-start-5", "col-start-6", "col-start-7", "col-start-8", "col-start-9", "col-start-10", "col-start-11", "col-start-12", "col-start-13"];
const colEnd = ["", "", "", "col-end-3", "col-end-4", "col-end-5", "col-end-6", "col-end-7", "col-end-8", "col-end-9", "col-end-10", "col-end-11", "col-end-12", "col-end-13", "col-end-14"];
const span = (desde: number, hasta: number) => `${colStart[desde + 1]} ${colEnd[hasta + 2]}`;

const fila = "relative grid h-11 grid-cols-[150px_repeat(12,minmax(0,1fr))] items-center border-b border-cream-tert last:border-b-0";
---

<section id="temporadas" class="pt-20 sm:pt-28" data-screen-label="Temporadas">
  <div class="mx-auto max-w-300 px-5 sm:px-7">
    <SectionHeader
      label={{ es: "Temporadas", en: "Seasons" }}
      title={{ es: "Qué pasa en la finca cada mes", en: "What happens on the farm each month" }}
      intro={{
        es: "En Mendoza cada cultivo tiene su momento. Las actividades de la plataforma siguen el calendario de los cultivos de cada finca.",
        en: "In Mendoza every crop has its moment. Activities on the platform follow the calendar of each farm’s crops.",
      }}
    />

    <div class="reveal mt-12 rounded-lg border border-outline-variant bg-surface px-4 pb-5 pt-6 sm:px-7">
      <!-- La grilla necesita ~720px: en pantallas angostas scrollea en horizontal. -->
      <div class="overflow-x-auto">
        <div class="min-w-180" data-seasons>
          <div class:list={[fila, "h-8 border-b-outline-variant"]}>
            <div></div>
            {
              meses.es.map((m, i) => (
                <div
                  class="text-center text-xs font-semibold uppercase tracking-[.06em] text-fg-3 data-now:text-green-800"
                  data-month={i + 1}
                  data-en={meses.en[i]}
                >
                  {m}
                </div>
              ))
            }
          </div>
          {
            cultivos.map((c) => (
              <div class:list={[fila, "hover:bg-cream-tert"]}>
                <div class="col-start-1 row-start-1 pl-1 text-[14.5px] font-medium">
                  <T t={c.nombre} />
                </div>
                {/* Columna del mes actual: el script le pone `data-now` a la que corresponde. */}
                {meses.es.map((_, i) => (
                  <span
                    class:list={[
                      colStart[i + 2],
                      "row-start-1 self-stretch data-now:border-x data-now:border-dashed data-now:border-green-300 data-now:bg-green-050",
                    ]}
                    data-month={i + 1}
                  />
                ))}
                {c.poda.map(([a, b]) => (
                  <span class:list={[span(a, b), "row-start-1 mx-[3px] h-3 rounded-pill bg-season-rest/55"]} />
                ))}
                {c.cosecha.map(([a, b]) => (
                  <span class:list={[span(a, b), "row-start-1 mx-[3px] h-3 rounded-pill bg-season-harvest"]} />
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-4 flex flex-wrap justify-between gap-x-6 gap-y-3 border-t border-outline-variant pt-4 text-[13px] text-fg-2">
        <div class="flex flex-wrap gap-5">
          <span class="flex items-center gap-2">
            <i class="inline-block h-2 w-5 rounded-sm bg-season-harvest"></i><T t={{ es: "Cosecha", en: "Harvest" }} />
          </span>
          <span class="flex items-center gap-2">
            <i class="inline-block h-2 w-5 rounded-sm bg-season-rest/55"></i><T t={{ es: "Poda", en: "Pruning" }} />
          </span>
          <span class="flex items-center gap-2">
            <i class="inline-block h-2 w-5 rounded-sm border border-dashed border-green-300 bg-green-050"></i><T
              t={{ es: "Mes actual", en: "Current month" }}
            />
          </span>
        </div>
        <T t={{ es: "Fechas aproximadas; varían según la zona y el año.", en: "Approximate dates; they vary by area and year." }} />
      </div>
    </div>
  </div>
</section>
