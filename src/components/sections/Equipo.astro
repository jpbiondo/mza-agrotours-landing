---
import { equipo } from "../../data/landing";
import GithubIcon from "../ui/GithubIcon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import T from "../ui/T.astro";
---

<section id="equipo" class="py-20 sm:py-28" data-screen-label="Equipo">
  <div class="mx-auto max-w-300 px-5 sm:px-7">
    <SectionHeader
      label={{ es: "Equipo", en: "Team" }}
      title={{ es: "Quiénes lo hicimos", en: "Who built it" }}
      intro={{
        es: "Somos el Grupo 6, un equipo de cuatro integrantes.",
        en: "We’re Group 6, a team of four.",
      }}
    />

    <div class="mt-12 grid gap-4 sm:grid-cols-2 desk:grid-cols-4">
      {
        equipo.map(({ nombre, github, rol }) => {
          return (
            <a
              href={`https://github.com/${github}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${nombre} en GitHub`}
              class="reveal group flex flex-col gap-3.5 rounded-lg border border-outline-variant bg-surface p-5 text-fg-1 no-underline transition-[box-shadow,border-color] duration-150 ease-brand hover:border-sand hover:text-fg-1 hover:shadow-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
            >
              {/* Avatar servido por GitHub: se actualiza solo cuando cambian su foto. */}
              <img
                src={`https://github.com/${github}.png?size=128`}
                alt=""
                width="64"
                height="64"
                loading="lazy"
                class="size-16 rounded-full bg-cream-tert object-cover"
              />
              <div>
                <b class="block font-display text-base font-semibold">{nombre}</b>
                <small class="mt-1 block text-[13.5px] leading-[1.45] text-fg-2">
                  <T t={rol} />
                </small>
              </div>
              <span class="mt-auto flex items-center gap-1.5 font-mono text-xs text-fg-3 transition-colors group-hover:text-green-800">
                <GithubIcon size={14} />
                {github}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
