---
import { getImage } from "astro:assets";
import { Maximize2, X } from "@lucide/astro";

import { comoFunciona } from "../../data/landing";
import { captura as buscarCaptura } from "../../lib/assets";
import { colorPerfil } from "../../lib/perfiles";
import BrowserFrame from "../BrowserFrame.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import T from "../ui/T.astro";

// La solución al problema de la sección anterior, paso a paso y por perfil.
// Cada captura se puede ampliar: el botón guarda la versión grande y
// src/scripts/landing.ts la abre en el <dialog> de abajo. Si la captura
// todavía no está, el paso se muestra sin botón.
const recorridos = await Promise.all(
  comoFunciona.map(async (r) => ({
    ...r,
    pasos: await Promise.all(
      r.pasos.map(async (paso) => {
        const imagen = buscarCaptura(paso.captura);
        const grande = imagen ? await getImage({ src: imagen, width: Math.min(imagen.width, 1920) }) : undefined;
        return { ...paso, grande };
      }),
    ),
  })),
);
---

<!-- Fondo crema: va entre Problema y Módulos, que son arena. -->
<section id="como-funciona" class="py-20 sm:py-28" data-screen-label="Cómo funciona">
  <div class="mx-auto max-w-300 px-5 sm:px-7">
    <SectionHeader
      label={{ es: "Cómo funciona", en: "How it works" }}
      title={{ es: "Cuatro pasos, para visitantes y productores", en: "Four steps, for visitors and producers" }}
      intro={{ es: "Elegí un perfil para ver su recorrido, pantalla por pantalla.", en: "Pick a role to see its journey, screen by screen." }}
    />

    <!-- `reveal` va en el contenedor y no en cada recorrido: uno arranca oculto y, si
         tuviera su propio `reveal`, al mostrarlo quedaría transparente. -->
    <div class="reveal mt-8">
      <span id="recorrido-label" class="sr-only"><T t={{ es: "Ver el recorrido de", en: "Show the journey of" }} /></span>
      <div class="inline-flex gap-1 rounded-pill border border-outline-variant bg-surface p-1" role="group" aria-labelledby="recorrido-label">
        {
          recorridos.map(({ perfil, nombre }, i) => (
            <button
              type="button"
              aria-pressed={i === 0 ? "true" : "false"}
              data-recorrido-boton={perfil}
              class:list={[
                "group inline-flex cursor-pointer items-center gap-2 rounded-pill px-4 py-2 text-sm font-medium text-fg-2 transition-colors duration-200 ease-brand aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-warning",
                colorPerfil[perfil].boton,
              ]}
            >
              <i class:list={["size-2 rounded-full group-aria-pressed:bg-white", colorPerfil[perfil].punto]} aria-hidden="true" />
              <T t={nombre} />
            </button>
          ))
        }
      </div>

      <!-- En mobile (una columna) cada recorrido es una línea de tiempo: número y línea
           a la izquierda, y el título arriba de su captura, así queda claro qué imagen
           es de qué paso. Desde sm vuelve a la grilla con captura, "Paso N", título y texto. -->
      {
        recorridos.map(({ perfil, pasos }, r) => {
          const color = colorPerfil[perfil];
          return (
            <ol class="mt-10 grid gap-x-6 sm:grid-cols-2 sm:gap-y-10 desk:grid-cols-4" data-recorrido={perfil} hidden={r !== 0}>
              {pasos.map(({ titulo, desc, pantalla, captura, grande }, i) => (
                <li class="relative grid min-w-0 grid-cols-[34px_minmax(0,1fr)] gap-x-4 pb-10 last:pb-0 sm:block sm:pb-0">
                  <span
                    class:list={["grid size-8.5 place-items-center rounded-full font-mono text-sm font-semibold text-white sm:hidden", color.numero]}
                    aria-hidden="true"
                  >
                    {i + 1}
                  </span>
                  {i < pasos.length - 1 && (
                    <span class:list={["absolute bottom-0 left-4 top-8.5 w-0.5 sm:hidden", color.linea]} aria-hidden="true" />
                  )}
                  <div class="flex min-w-0 flex-col gap-3.5">
                    <div class="order-2 sm:order-1">
                      {grande ? (
                        <button
                          type="button"
                          class="group relative block cursor-zoom-in rounded-lg text-left transition-transform duration-200 ease-brand hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-800 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                          data-ampliar={grande.src}
                          data-ampliar-ancho={grande.attributes.width}
                          data-ampliar-alto={grande.attributes.height}
                          data-ampliar-es={pantalla.es}
                          data-ampliar-en={pantalla.en}
                        >
                          <BrowserFrame
                            label={pantalla}
                            shot={captura}
                            viewport="aspect-[16/11]"
                            class="transition-shadow duration-200 group-hover:shadow-[0_14px_36px_rgba(45,90,39,.2)]"
                          />
                          <span
                            class="absolute bottom-3 right-3 grid size-9 place-items-center rounded-full bg-green-900/80 text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
                            aria-hidden="true"
                          >
                            <Maximize2 size={16} stroke-width={2} />
                          </span>
                          <T t={{ es: `Ampliar captura: ${pantalla.es}`, en: `Enlarge screenshot: ${pantalla.en}` }} class="sr-only" />
                        </button>
                      ) : (
                        <BrowserFrame label={pantalla} shot={captura} viewport="aspect-[16/11]" />
                      )}
                    </div>
                    <span class="mt-1 hidden font-mono text-[13px] font-medium uppercase tracking-[.06em] text-warning-fg sm:order-2 sm:block">
                      <T t={{ es: `Paso ${i + 1}`, en: `Step ${i + 1}` }} />
                    </span>
                    <h3 class="order-1 pt-1 text-[19px] font-semibold sm:order-3 sm:pt-0">
                      <T t={titulo} />
                    </h3>
                    <p class="order-3 text-[14.5px] leading-normal text-fg-2 sm:order-4">
                      <T t={desc} />
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          );
        })
      }
    </div>
  </div>

  <!-- Visor: se cierra con Esc, con el botón o haciendo click afuera de la imagen. -->
  <dialog
    class="m-auto max-h-[92vh] max-w-[min(1400px,94vw)] overflow-visible bg-transparent p-0 backdrop:bg-green-900/85 backdrop:backdrop-blur-sm"
    data-visor
  >
    <img src="" alt="" class="block h-auto max-h-[88vh] w-auto max-w-full rounded-lg shadow-pop" data-visor-img />
    <button
      type="button"
      class="absolute -top-3 -right-3 grid size-10 cursor-pointer place-items-center rounded-full bg-surface text-fg-1 shadow-pop hover:bg-cream-tert focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800"
      data-visor-cerrar
    >
      <X size={18} stroke-width={2} aria-hidden="true" />
      <T t={{ es: "Cerrar", en: "Close" }} class="sr-only" />
    </button>
  </dialog>
</section>
