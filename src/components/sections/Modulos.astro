---
import { Check } from "@lucide/astro";

import { modulos } from "../../data/landing";
import { foto } from "../../lib/assets";
import BrowserFrame from "../BrowserFrame.astro";
import Photo from "../Photo.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import T from "../ui/T.astro";

const total = String(modulos.length).padStart(2, "0");
---

<section id="modulos" class="bg-brown-100 py-20 sm:py-28" data-screen-label="Módulos">
  <div class="mx-auto max-w-300 px-5 sm:px-7">
    <SectionHeader
      label={{ es: "Módulos", en: "Modules" }}
      title={{ es: "Seis módulos, tres perfiles", en: "Six modules, three roles" }}
      intro={{
        es: "Pantallas del prototipo de la plataforma. Elegí un módulo para verlo.",
        en: "Screens from the platform prototype. Pick a module to see it.",
      }}
    />

    <!-- Una sola fila; si no entra (mobile), se desplaza de costado. Las sombras de
         los bordes aparecen solo del lado donde hay más pestañas: el script marca
         `data-izq` / `data-der` según la posición del scroll. -->
    <div class="reveal group relative mt-10 w-fit max-w-full overflow-hidden rounded-md border border-outline-variant bg-surface" data-scroll-sombras>
      <div
        class="flex scrollbar-none gap-1 overflow-x-auto overscroll-x-contain p-1 [&::-webkit-scrollbar]:hidden"
        role="tablist"
        aria-label="Módulos"
        data-tabs
        data-scroll
      >
        {
          modulos.map((m, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${i}`}
              aria-controls={`modulo-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="shrink-0 cursor-pointer whitespace-nowrap rounded-sm px-3.5 py-2 text-sm font-medium text-fg-2 transition-colors duration-150 ease-brand not-aria-selected:hover:bg-cream-tert aria-selected:bg-green-800 aria-selected:font-semibold aria-selected:text-white"
            >
              <T t={m.tab} />
            </button>
          ))
        }
      </div>
      <span
        class="pointer-events-none absolute inset-y-0 left-0 w-8 bg-linear-to-r from-fg-1/12 to-transparent opacity-0 transition-opacity duration-200 group-data-izq:opacity-100"
        aria-hidden="true"
      ></span>
      <span
        class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-linear-to-l from-fg-1/12 to-transparent opacity-0 transition-opacity duration-200 group-data-der:opacity-100"
        aria-hidden="true"
      ></span>
    </div>

    {
      modulos.map((m, i) => (
        <div
          id={`modulo-${i}`}
          role="tabpanel"
          aria-labelledby={`tab-${i}`}
          hidden={i !== 0}
          class="mt-8 grid items-start gap-10 transition-opacity duration-200 ease-brand data-fade:opacity-0 desk:grid-cols-[minmax(0,.85fr)_minmax(0,1.6fr)]"
        >
          <div>
            <span class="font-mono text-[13px] text-brown-700">
              {String(i + 1).padStart(2, "0")} / {total}
            </span>
            <h3 class="mt-2 text-h2 font-bold leading-[1.25]"><T t={m.titulo} /></h3>
            <p class="mt-3 text-[15.5px] leading-relaxed text-fg-2"><T t={m.desc} /></p>
            <ul class="mt-5 flex flex-col gap-2.5">
              {m.puntos.map((p) => (
                <li class="grid grid-cols-[18px_1fr] gap-2.5 text-[14.5px] leading-normal">
                  <Check size={16} stroke-width={1.75} class="mt-[3px] text-green-800" />
                  <T t={p} />
                </li>
              ))}
            </ul>
            {foto(m.foto) && (
              <Photo name={m.foto} alt="" sizes="(max-width: 1000px) 100vw, 400px" class="mt-6 h-45 w-full rounded-xl" />
            )}
          </div>
          <BrowserFrame label={m.pantalla} shot={m.captura} viewport="h-80 sm:h-105 desk:h-135" />
        </div>
      ))
    }
  </div>
</section>
