---
import { Backpack, ShieldCheck, Tractor } from "@lucide/astro";

import { alcance } from "../../data/landing";
import Pill from "../ui/Pill.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import T from "../ui/T.astro";

const iconos = {
  backpack: { Icon: Backpack, color: "text-green-800" },
  tractor: { Icon: Tractor, color: "text-brown-700" },
  "shield-check": { Icon: ShieldCheck, color: "text-info" },
};
---

<section id="alcance" class="pt-20 sm:pt-28" data-screen-label="Alcance">
  <div class="mx-auto max-w-300 px-5 sm:px-7">
    <SectionHeader label={{ es: "Alcance", en: "Scope" }} title={{ es: "Qué puede hacer cada perfil", en: "What each role can do" }} />

    <div class="mt-12 grid gap-6 desk:grid-cols-3">
      {
        alcance.map(({ perfil, tono, icono, items }) => {
          const { Icon, color } = iconos[icono];
          return (
            <div class="reveal rounded-lg border border-outline-variant bg-surface p-6">
              <div class="mb-1 flex items-center justify-between">
                <Pill tone={tono}>
                  <T t={perfil} />
                </Pill>
                <Icon size={20} stroke-width={1.75} class={color} />
              </div>
              {items.map(([titulo, desc]) => (
                <div class="border-b border-cream-tert py-4 last:border-b-0 last:pb-0">
                  <h4 class="text-[15px] font-semibold">
                    <T t={titulo} />
                  </h4>
                  <p class="mt-1 text-sm leading-normal text-fg-2">
                    <T t={desc} />
                  </p>
                </div>
              ))}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
