---
import { User } from "@lucide/astro";
import { arquitectura, stack, type Txt } from "../data/landing";

// Diagrama de arquitectura de la sección Tecnología. SVG con coordenadas fijas
// (viewBox de 1120 de ancho, se ve a ~1:1 desde `desk:`); los textos son
// <text> con `data-en`, así el cambio de idioma los traduce como al resto.
// Las relaciones reflejan el código de la app: el clima lo pide el backend y
// lo cachea en Redis; Firebase lo usan el front y el back; Google Maps, solo el front.

// Busca por nombre para que, si alguien renombra algo en `stack`, falle el build.
const items = stack.flatMap((c) => c.items);
function item(nombre: string) {
  const it = items.find((i) => i.nombre.es === nombre);
  if (!it) throw new Error(`Arquitectura: falta "${nombre}" en stack`);
  return it;
}
function capa(nombre: string): Txt {
  const c = stack.find((s) => s.capa.es === nombre);
  if (!c) throw new Error(`Arquitectura: falta la capa "${nombre}" en stack`);
  return c.capa;
}

const front = item("Aplicación web");
const api = item("API REST");
const postgres = item("PostgreSQL 16");

type Nodo = { x: number; y: number; w: number; h: number; titulo: Txt; sub: Txt | string; mono?: boolean };

// Columna de datos: centradas en y = 82 / 160 / 238.
const datos: Nodo[] = [
  {
    x: 875, y: 52, w: 210, h: 60, titulo: postgres.nombre,
    sub: { es: `${postgres.tipo.es} · Amazon RDS`, en: `${postgres.tipo.en} · Amazon RDS` },
  },
  { x: 875, y: 130, w: 210, h: 60, titulo: item("Redis 7").nombre, sub: item("Redis 7").tipo },
  { x: 875, y: 208, w: 210, h: 60, titulo: item("Amazon S3").nombre, sub: item("Amazon S3").tipo },
];

// Fila de integraciones: centradas en x = 320 / 485 / 690 / 860 / 1030.
const externos: Nodo[] = ["Google Maps", "Firebase", "Mercado Pago", "OpenWeather", "Amazon SES"].map((n, i) => ({
  x: [250, 415, 620, 790, 960][i], y: 392, w: 140, h: 64, titulo: item(n).nombre, sub: item(n).tipo,
}));

const principales: Nodo[] = [
  { x: 225, y: 115, w: 190, h: 90, titulo: front.nombre, sub: front.chips?.[0] ?? "", mono: true },
  { x: 555, y: 115, w: 190, h: 90, titulo: api.nombre, sub: api.chips?.[1] ?? "", mono: true },
];

// Conexiones; `flecha: false` para tramos que se unen a otro (Firebase).
const lineas: { d: string; flecha?: boolean }[] = [
  { d: "M140 160 H223" }, // usuario → front
  { d: "M415 160 H553" }, // front → API
  { d: "M745 160 H873" }, // API → Redis
  { d: "M745 160 H810 V82 H873" }, // API → PostgreSQL
  { d: "M745 160 H810 V238 H873" }, // API → S3
  { d: "M320 205 V390" }, // front → Google Maps
  { d: "M385 205 V300 H485 V390" }, // front → Firebase
  { d: "M585 205 V300 H485", flecha: false }, // API → Firebase
  { d: "M690 205 V390" }, // API → Mercado Pago
  { d: "M690 310 H860 V390" }, // API → OpenWeather
  { d: "M690 310 H1030 V390" }, // API → SES
];

const chips = ["Docker", "Amazon EC2"];
const anchoChip = (s: string) => s.length * 6.6 + 16;
// Chips arriba a la derecha de la capa (ahí no pasan líneas), separados 6.
const xChips = chips.map((_, i) => chips.slice(i).reduce((x, c) => x - anchoChip(c) - 6, 771));

const en = (t: Txt | string) => (typeof t === "string" ? undefined : t.en);
const es = (t: Txt | string) => (typeof t === "string" ? t : t.es);
---

<svg
  viewBox="0 0 1120 490"
  class="h-auto w-full font-sans"
  role="img"
  aria-labelledby="arq-titulo arq-desc"
>
  <title id="arq-titulo" data-en={arquitectura.titulo.en}>{arquitectura.titulo.es}</title>
  <desc id="arq-desc" data-en={arquitectura.desc.en}>{arquitectura.desc.es}</desc>

  <defs>
    <marker id="arq-flecha" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="fill-brown-700" />
    </marker>
  </defs>

  <!-- Capas -->
  <rect x="190" y="60" width="260" height="200" rx="18" class="fill-green-100" />
  <text x="210" y="88" class="fill-green-800 text-[11px] font-semibold uppercase tracking-[.12em]" data-en={capa("Aplicación").en}>
    {capa("Aplicación").es}
  </text>

  <rect x="520" y="60" width="260" height="200" rx="18" class="fill-brown-100" />
  <text x="540" y="88" class="fill-brown-800 text-[11px] font-semibold uppercase tracking-[.12em]" data-en={capa("Servicio").en}>
    {capa("Servicio").es}
  </text>
  {
    chips.map((c, i) => (
      <g>
        <rect x={xChips[i]} y="71" width={anchoChip(c)} height="22" rx="11" class="fill-surface" />
        <text x={xChips[i] + anchoChip(c) / 2} y="86" text-anchor="middle" class="fill-fg-2 font-mono text-[11px]">{c}</text>
      </g>
    ))
  }

  <rect x="850" y="10" width="260" height="290" rx="18" class="fill-cream-tert stroke-outline-variant" />
  <text x="870" y="38" class="fill-fg-2 text-[11px] font-semibold uppercase tracking-[.12em]" data-en={capa("Datos").en}>
    {capa("Datos").es}
  </text>

  <rect x="190" y="340" width="920" height="140" rx="18" class="fill-none stroke-brown-200" stroke-width="1.5" stroke-dasharray="6 5" />
  <text x="210" y="368" class="fill-brown-700 text-[11px] font-semibold uppercase tracking-[.12em]" data-en={capa("Integraciones").en}>
    {capa("Integraciones").es}
  </text>

  <!-- Conexiones (antes que los nodos, para que queden debajo) -->
  {
    lineas.map(({ d, flecha = true }) => (
      <path d={d} class="fill-none stroke-brown-700" stroke-width="2" marker-end={flecha ? "url(#arq-flecha)" : undefined} />
    ))
  }
  <text x="484" y="150" text-anchor="middle" class="fill-fg-3 font-mono text-[11px]">REST · JSON</text>

  <!-- Usuario -->
  <rect x="10" y="120" width="130" height="80" rx="12" class="fill-surface stroke-green-900" stroke-width="1.5" />
  <User x={64} y={130} width={22} height={22} class="text-green-800" />
  <text x="75" y="174" text-anchor="middle" class="fill-fg-1 text-[15px] font-semibold" data-en={arquitectura.usuario.en}>
    {arquitectura.usuario.es}
  </text>
  <text x="75" y="191" text-anchor="middle" class="fill-fg-3 text-[12.5px]" data-en={arquitectura.navegador.en}>
    {arquitectura.navegador.es}
  </text>

  <!-- Nodos propios -->
  {
    [...principales, ...datos].map((n) => (
      <g>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" class="fill-surface stroke-green-900" stroke-width="1.5" />
        <text x={n.x + n.w / 2} y={n.y + n.h / 2 - 4} text-anchor="middle" class="fill-fg-1 text-[15px] font-semibold" data-en={en(n.titulo)}>
          {es(n.titulo)}
        </text>
        <text
          x={n.x + n.w / 2}
          y={n.y + n.h / 2 + 15}
          text-anchor="middle"
          class:list={["fill-fg-2", n.mono ? "font-mono text-[12px]" : "text-[12.5px]"]}
          data-en={en(n.sub)}
        >
          {es(n.sub)}
        </text>
      </g>
    ))
  }

  <!-- Servicios externos: borde punteado -->
  {
    externos.map((n) => (
      <g>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" class="fill-surface stroke-brown-500" stroke-width="1.5" stroke-dasharray="5 4" />
        <text x={n.x + n.w / 2} y={n.y + 28} text-anchor="middle" class="fill-fg-1 text-[14px] font-semibold" data-en={en(n.titulo)}>
          {es(n.titulo)}
        </text>
        <text x={n.x + n.w / 2} y={n.y + 46} text-anchor="middle" class="fill-fg-3 text-[12.5px]" data-en={en(n.sub)}>
          {es(n.sub)}
        </text>
      </g>
    ))
  }
</svg>
