---
// Pill de estado del design system: punto de color + texto, sobre un relleno suave.
// `brown` es el color del productor (ver Proyecto.astro).
interface Props {
  tone?: "success" | "warning" | "info" | "brown" | "neutral";
  class?: string;
}

const { tone = "neutral", class: className } = Astro.props;

const tones = {
  success: "bg-success-fill text-success-fg",
  warning: "bg-warning-fill text-warning-fg",
  info: "bg-info-fill text-info-fg",
  brown: "bg-brown-200 text-brown-800",
  neutral: "bg-cream-tert text-fg-2",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 whitespace-nowrap rounded-pill px-3 py-1.5 font-sans text-xs font-semibold leading-none before:size-[7px] before:rounded-full before:bg-current before:opacity-90 before:content-['']",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
